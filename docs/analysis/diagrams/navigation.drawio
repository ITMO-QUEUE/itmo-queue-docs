<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Карта страниц" id="map"><mxGraphModel grid="1" page="1" pageWidth="1400" pageHeight="1390"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="ITMO.Queue   /   Карта страниц MVP" vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=32;fontColor=#23384b;fontStyle=1;"><mxGeometry as="geometry" x="55" y="15" width="1245" height="38" /></mxCell><mxCell id="v2" value="Для обсуждения · по итогам встречи 26 октября 2026 · пути предложены для маршрутизации" vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#23384b;fontStyle=0;"><mxGeometry as="geometry" x="55" y="62" width="1245" height="22" /></mxCell><mxCell id="auth" value="&lt;b style=&quot;color:#295f99;font-size:20px&quot;&gt;Вход и регистрация&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#295f99&quot;&gt;/auth&lt;/span&gt;&lt;br&gt;&lt;br&gt;Две формы на одной странице. После входа&lt;br&gt;назначенная роль определяет кабинет." vertex="1" parent="1" style="rounded=1;arcSize=6;fillColor=#eff6fd;strokeColor=#295f99;strokeWidth=2;dashed=0;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Arial;fontSize=16;fontColor=#23384b;"><mxGeometry as="geometry" x="455" y="106" width="490" height="124" /></mxCell><mxCell id="v4" value="01   СТУДЕНТ" vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#295f99;fontStyle=1;"><mxGeometry as="geometry" x="78" y="273" width="1222" height="27" /></mxCell><mxCell id="v5" value="02   ПРЕПОДАВАТЕЛЬ" vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#176559;fontStyle=1;"><mxGeometry as="geometry" x="765" y="273" width="535" height="27" /></mxCell><mxCell id="sd" value="&lt;b style=&quot;color:#295f99;font-size:20px&quot;&gt;Мои записи&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#295f99&quot;&gt;/student&lt;/span&gt;&lt;br&gt;&lt;br&gt;Свои активные и предстоящие записи, фильтры.&lt;br&gt;При старте защиты — плашка «Открыть запись».&lt;br&gt;Выход из очереди доступен по правилам топ-3." vertex="1" parent="1" style="rounded=1;arcSize=6;fillColor=#eff6fd;strokeColor=#295f99;strokeWidth=2;dashed=0;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Arial;fontSize=16;fontColor=#23384b;"><mxGeometry as="geometry" x="78" y="320" width="535" height="178" /></mxCell><mxCell id="td" value="&lt;b style=&quot;color:#176559;font-size:20px&quot;&gt;Мои очереди&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#176559&quot;&gt;/teacher&lt;/span&gt;&lt;br&gt;&lt;br&gt;Созданные и назначенные сеансы. Приглашение&lt;br&gt;со-преподавателю → подтвердить участие.&lt;br&gt;Выбрать сеанс или нажать «Создать очередь»." vertex="1" parent="1" style="rounded=1;arcSize=6;fillColor=#eff8f5;strokeColor=#176559;strokeWidth=2;dashed=0;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Arial;fontSize=16;fontColor=#23384b;"><mxGeometry as="geometry" x="765" y="320" width="558" height="365" /></mxCell><mxCell id="modal" value="&lt;b style=&quot;color:#99551f;font-size:20px&quot;&gt;Создать очередь&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#99551f&quot;&gt;МОДАЛЬНОЕ ОКНО · без нового маршрута&lt;/span&gt;&lt;br&gt;&lt;br&gt;Дисциплина, работы и приоритеты, принимающие,&lt;br&gt;квота, время и место защиты.&lt;br&gt;Отмена → закрыть окно и остаться в списке.&lt;br&gt;Успех → открыть управление созданной очередью." vertex="1" parent="td" style="rounded=1;arcSize=6;fillColor=#fff6e9;strokeColor=#99551f;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Arial;fontSize=16;fontColor=#23384b;"><mxGeometry as="geometry" x="30" y="148" width="500" height="190" /></mxCell><mxCell id="catalog" value="&lt;b style=&quot;color:#295f99;font-size:20px&quot;&gt;Найти очередь&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#295f99&quot;&gt;/student/queues&lt;/span&gt;&lt;br&gt;&lt;br&gt;Каталог доступных сеансов. Фильтры по предмету,&lt;br&gt;преподавателю и потоку. Открыть выбранную очередь." vertex="1" parent="1" style="rounded=1;arcSize=6;fillColor=#eff6fd;strokeColor=#295f99;strokeWidth=2;dashed=0;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Arial;fontSize=16;fontColor=#23384b;"><mxGeometry as="geometry" x="78" y="575" width="535" height="133" /></mxCell><mxCell id="detail" value="&lt;b style=&quot;color:#295f99;font-size:20px&quot;&gt;Конкретная очередь / моя запись&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#295f99&quot;&gt;/student/queues/:queueId&lt;/span&gt;&lt;br&gt;&lt;br&gt;До записи: выбрать работы и загрузить отчёт.&lt;br&gt;При превышении квоты — предупреждение, запись&lt;br&gt;разрешена. Резерв отмечен подписью и границей.&lt;br&gt;После записи: место, ожидание, вызов и артефакты.&lt;br&gt;Выход, перенос в конец и обмен — вне топ-3,&lt;br&gt;пока студент ожидает и ещё не вызван." vertex="1" parent="1" style="rounded=1;arcSize=6;fillColor=#eff6fd;strokeColor=#295f99;strokeWidth=2;dashed=0;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Arial;fontSize=16;fontColor=#23384b;"><mxGeometry as="geometry" x="78" y="775" width="535" height="244" /></mxCell><mxCell id="manage" value="&lt;b style=&quot;color:#176559;font-size:20px&quot;&gt;Управление очередью&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#176559&quot;&gt;/teacher/queues/:queueId&lt;/span&gt;&lt;br&gt;&lt;br&gt;Список участников, артефакты, текущие защиты.&lt;br&gt;Вручную: открыть/закрыть запись, начать/завершить&lt;br&gt;сеанс. Вызов вне очереди — с подтверждением.&lt;br&gt;Результаты по работам и история — внутри сеанса.&lt;br&gt;Подтвердивший участие со-преподаватель сохраняет&lt;br&gt;права управления, даже если создатель вышел." vertex="1" parent="1" style="rounded=1;arcSize=6;fillColor=#eff8f5;strokeColor=#176559;strokeWidth=2;dashed=0;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Arial;fontSize=16;fontColor=#23384b;"><mxGeometry as="geometry" x="765" y="775" width="558" height="244" /></mxCell><mxCell id="hist" value="&lt;b style=&quot;color:#295f99;font-size:20px&quot;&gt;История попыток&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#295f99&quot;&gt;/student/history&lt;/span&gt;&lt;br&gt;&lt;br&gt;Календарь сдач, работы, результаты и неявки." vertex="1" parent="1" style="rounded=1;arcSize=6;fillColor=#eff6fd;strokeColor=#295f99;strokeWidth=2;dashed=0;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Arial;fontSize=16;fontColor=#23384b;"><mxGeometry as="geometry" x="78" y="1092" width="535" height="116" /></mxCell><mxCell id="sp" value="&lt;b style=&quot;color:#295f99;font-size:20px&quot;&gt;Профиль студента&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#295f99&quot;&gt;/student/profile&lt;/span&gt;&lt;br&gt;&lt;br&gt;Аккаунт, настройки и выход → /auth." vertex="1" parent="1" style="rounded=1;arcSize=6;fillColor=#eff6fd;strokeColor=#295f99;strokeWidth=2;dashed=0;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Arial;fontSize=16;fontColor=#23384b;"><mxGeometry as="geometry" x="78" y="1234" width="535" height="106" /></mxCell><mxCell id="tp" value="&lt;b style=&quot;color:#176559;font-size:20px&quot;&gt;Профиль преподавателя&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#176559&quot;&gt;/teacher/profile&lt;/span&gt;&lt;br&gt;&lt;br&gt;Аккаунт, настройки и выход → /auth." vertex="1" parent="1" style="rounded=1;arcSize=6;fillColor=#eff8f5;strokeColor=#176559;strokeWidth=2;dashed=0;align=left;verticalAlign=top;spacing=14;html=1;fontFamily=Arial;fontSize=16;fontColor=#23384b;"><mxGeometry as="geometry" x="765" y="1092" width="558" height="116" /></mxCell><mxCell id="e15" edge="1" parent="1" source="auth" target="sd" style="edgeStyle=none;endArrow=block;strokeColor=#466179;strokeWidth=2;exitX=0.09183673469387756;exitY=1.0;entryX=0.49906542056074765;entryY=0.0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="500" y="256" /><mxPoint x="345" y="256" /></Array></mxGeometry></mxCell><mxCell id="e16" edge="1" parent="1" source="auth" target="td" style="edgeStyle=none;endArrow=block;strokeColor=#466179;strokeWidth=2;exitX=0.9081632653061225;exitY=1.0;entryX=0.510752688172043;entryY=0.0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="900" y="256" /><mxPoint x="1050" y="256" /></Array></mxGeometry></mxCell><mxCell id="e17" edge="1" parent="1" source="sd" target="catalog" style="edgeStyle=none;endArrow=block;strokeColor=#466179;strokeWidth=2;exitX=0.49906542056074765;exitY=1.0;entryX=0.49906542056074765;entryY=0.0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="v18" value="Найти новую очередь" vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#23384b;fontStyle=0;"><mxGeometry as="geometry" x="362" y="526" width="938" height="21" /></mxCell><mxCell id="e19" edge="1" parent="1" source="catalog" target="detail" style="edgeStyle=none;endArrow=block;strokeColor=#466179;strokeWidth=2;exitX=0.49906542056074765;exitY=1.0;entryX=0.49906542056074765;entryY=0.0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="v20" value="Открыть" vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#23384b;fontStyle=0;"><mxGeometry as="geometry" x="361" y="733" width="939" height="21" /></mxCell><mxCell id="e21" edge="1" parent="1" source="sd" target="detail" style="edgeStyle=none;endArrow=block;strokeColor=#466179;strokeWidth=2;exitX=0.0;exitY=0.5730337078651685;entryX=0.0;entryY=0.46311475409836067;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="39" y="422" /><mxPoint x="39" y="888" /></Array></mxGeometry></mxCell><mxCell id="e22" edge="1" parent="1" source="td" target="manage" style="edgeStyle=none;endArrow=block;strokeColor=#466179;strokeWidth=2;exitX=1.0;exitY=0.2493150684931507;entryX=1.0;entryY=0.3975409836065574;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1352" y="411" /><mxPoint x="1352" y="872" /></Array></mxGeometry></mxCell><mxCell id="e23" edge="1" parent="1" source="modal" target="manage" style="edgeStyle=none;endArrow=block;strokeColor=#466179;strokeWidth=2;exitX=0.5;exitY=1.0;entryX=0.5017921146953405;entryY=0.0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="v24" value="Создано" vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=15;fontColor=#23384b;fontStyle=0;"><mxGeometry as="geometry" x="1060" y="720" width="240" height="21" /></mxCell><mxCell id="v25" value="Также из бокового меню студента:" vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#23384b;fontStyle=1;"><mxGeometry as="geometry" x="78" y="1048" width="1222" height="22" /></mxCell><mxCell id="v26" value="Из меню преподавателя:" vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#23384b;fontStyle=1;"><mxGeometry as="geometry" x="765" y="1048" width="535" height="22" /></mxCell><mxCell id="v27" value="Общие переходы" vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#23384b;fontStyle=1;"><mxGeometry as="geometry" x="767" y="1239" width="533" height="26" /></mxCell><mxCell id="v28" value="/ → вход или кабинет по роли. Неизвестный путь → 404." vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#23384b;fontStyle=0;"><mxGeometry as="geometry" x="767" y="1277" width="533" height="22" /></mxCell><mxCell id="v29" value="Нет доступа к сеансу → сообщение и возврат в кабинет." vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#23384b;fontStyle=0;"><mxGeometry as="geometry" x="767" y="1305" width="533" height="22" /></mxCell><mxCell id="v30" value="Стрелка — переход между страницами. Пунктирная карточка внутри кабинета — окно поверх страницы." vertex="1" parent="1" style="text;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#23384b;fontStyle=0;"><mxGeometry as="geometry" x="55" y="1357" width="1245" height="22" /></mxCell></root></mxGraphModel></diagram></mxfile>